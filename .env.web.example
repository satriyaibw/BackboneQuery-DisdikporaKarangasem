# Template web layer — SALIN ke .env.web lalu isi nilai asli (jangan komit).
#   cp .env.web.example .env.web && chmod 600 .env.web

# Admin awal SQLPad (dibuat otomatis saat pertama start; tambah akun per teknisi via UI).
SQLPAD_ADMIN=admin@lokal
SQLPAD_ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

# Password role Postgres `analis` (read-only). Dipakai 2 tempat:
#   1. init_analis.sql (membuat role), 2. form koneksi di SQLPad (host db-target).
# HARUS beda dari DB_PASSWORD di .env dan dari password admin di atas.
ANALIS_DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_BERBEDA

# Prod saja (server kantor, Named Tunnel). KOSONGKAN di dev:
# TUNNEL_TOKEN=
