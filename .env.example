# Target database: sqlserver | postgres
DB_DIALECT=sqlserver
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=backbone_client
DB_AUTO_CREATE_DATABASE=true
DB_MAINTENANCE_DB=postgres

# Backbone API
BACKBONE_BASE_URL=https://api.data.kemendikdasmen.go.id/svc/satu-data/pendidikan/v3
BACKBONE_API_KEY=
BACKBONE_SERVICE_JWT=
BACKBONE_PER_PAGE=500

# Jadwal (Prefect serve)
SCHEDULE_CRON=0 2 * * *
SCHEDULE_TIMEZONE=Asia/Jakarta
DEPLOYMENT_NAME=backbone-client-pull
PULL_REF=false
