# Target database: sqlserver | postgres
DB_DIALECT=sqlserver
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=backbone_client
DB_AUTO_CREATE_DATABASE=true
DB_MAINTENANCE_DB=postgres

# Backbone API
BACKBONE_BASE_URL=https://api.data.kemendikdasmen.go.id/svc/satu-data/pendidikan/v3
BACKBONE_AUTH_URL=https://api.data.kemendikdasmen.go.id/svc/satu-data/auth/v1/access-token
BACKBONE_API_KEY=
# Kredensial akun Backbone (unik per client). Access-token (JWT) diambil otomatis
# dari username/password ini di tiap run — tidak perlu menempel JWT manual.
BACKBONE_USERNAME=
BACKBONE_PASSWORD=
BACKBONE_PER_PAGE=500
# Konkurensi penarikan (mempercepat tarikan). RATE_LIMIT = maks request/detik ke API
# (batas resmi saat ini 20); CONCURRENCY = maks entity ditarik paralel. Naikkan bila
# batas API dinaikkan / server kuat.
BACKBONE_RATE_LIMIT=20
BACKBONE_CONCURRENCY=16

# Jadwal
SCHEDULE_CRON=0 2 * * *
SCHEDULE_TIMEZONE=Asia/Jakarta
# Khusus mode `main.py --loop`: ambil tanggal jadwal akses otomatis dari
# GET /user-info/schedule Backbone (bukan tebak-tebak manual), digabung dengan
# jam:menit di SCHEDULE_CRON di atas. Beberapa kali percobaan berjeda per hari
# jadwal (RETRY_COUNT x, berjeda RETRY_INTERVAL_HOURS jam) sebagai jaga-jaga
# kalau percobaan pertama gagal (mis. gangguan jaringan sesaat).
SCHEDULE_AUTO_FROM_API=true
SCHEDULE_RETRY_COUNT=3
SCHEDULE_RETRY_INTERVAL_HOURS=4
DEPLOYMENT_NAME=backbone-client-pull
PULL_REF=false
# Retensi tabel sync.pull_log (ringkasan aktivitas penarikan per tabel per run).
# Baris lebih tua dari sekian hari dihapus otomatis di awal tiap run.
PULL_LOG_RETENTION_DAYS=60

# ── Prefect UI (opsional) ─────────────────────────────────────────────
# Biarkan sebagai komentar untuk mode ringan tanpa UI (tanpa server terpisah).
# Untuk memantau lewat Prefect UI: jalankan `docker compose up -d`
# (Prefect Server + PostgreSQL), lalu aktifkan baris di bawah:
# PREFECT_API_URL=http://127.0.0.1:4200/api
# Untuk Prefect Cloud, isi juga API key-nya:
# PREFECT_API_KEY=
